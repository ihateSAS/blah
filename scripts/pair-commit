#!/usr/bin/env bash
set -euo pipefail

if git diff --cached --quiet; then
  echo "No staged changes. Stage the work you created together first." >&2
  exit 1
fi

read -r -p "Commit message: " message
if [[ -z "${message// }" ]]; then
  echo "A meaningful commit message is required." >&2
  exit 1
fi

read -r -p "Contributor 1 name (example: ihateSAS): " name_one
read -r -p "Contributor 1 GitHub email: " email_one
read -r -p "Contributor 2 name (leave blank if you only want one co-author): " name_two

email_two=""
if [[ -n "${name_two// }" ]]; then
  read -r -p "Contributor 2 GitHub email: " email_two
fi

email_pattern='^[^[:space:]<>@]+@[^[:space:]<>@]+\.[^[:space:]<>@]+$'
if [[ -z "${name_one// }" || ! "$email_one" =~ $email_pattern ]]; then
  echo "Contributor 1 needs a name and valid GitHub-associated email." >&2
  exit 1
fi
if [[ -n "${name_two// }" && ! "$email_two" =~ $email_pattern ]]; then
  echo "Contributor 2 needs a valid GitHub-associated email." >&2
  exit 1
fi

echo
printf 'Staged changes:\n'
git diff --cached --stat

echo
printf 'Co-authors:\n'
printf '  %s <%s>\n' "$name_one" "$email_one"
if [[ -n "${name_two// }" ]]; then
  printf '  %s <%s>\n' "$name_two" "$email_two"
fi

echo
read -r -p "Did these people genuinely contribute to the staged change? [y/N] " confirmed
if [[ ! "$confirmed" =~ ^[Yy]$ ]]; then
  echo "Commit cancelled."
  exit 1
fi

args=(-m "$message" -m "Co-authored-by: $name_one <$email_one>")
if [[ -n "${name_two// }" ]]; then
  args+=(-m "Co-authored-by: $name_two <$email_two>")
fi

git commit "${args[@]}"
